    {
        "id": "b2d3b7095984b880",
        "type": "function",
        "z": "ec288c38e877de1a",
        "name": "function 2",
        "func": "msg.payload = \"SOME MEANINGFULL DATA\";\nnode.warn(\"A2AClient\")\nnode.warn(a2aJsSdkClient)\nnode.warn(msg);\nconst { A2AClient } = a2aJsSdkClient;\n\n\ntry {\n    const a2aRequest = { ...msg.chatboxPayload.a2aRequests.params }\n    const client = await A2AClient.fromCardUrl(msg.chatboxPayload.options.baseUrl + \"/.well-known/agent-card.json\");\n    const result = await client.sendMessage(a2aRequest);\n    node.warn(result);\n}\ncatch (e) {\n    node.warn(e);\n}\n\nmsg.callbackSuccess({\n    message: \"YAYAYAYYAY\"\n})\n// msg.callBackSuccess(\"Result\");\n// msg.handleCallback() // data\n// return msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
            {
                "var": "a2aJsSdkClient",
                "module": "@a2a-js/sdk/client"
            }
        ],
