        "z": "ec288c38e877de1a",
        "name": "DEMO A2A Request",
        "func": "const { A2AClient } = a2aJsSdkClient;\nconst a2aRequest = { ...msg.chatboxPayload.a2aRequests.params }\n\n\ntry {\n    node.warn(\"TRIGGERED\");\n    const client = await A2AClient.fromCardUrl(msg.chatboxPayload.options.baseUrl + \"/.well-known/agent-card.json\");\n    const result = await client.sendMessage(a2aRequest);\n    node.warn(result);\n    msg.callbackSuccess({\n        ...result\n    })\n}\ncatch (e) {\n    node.warn(e);\n    msg.callbackError(e.message);\n}\nreturn msg;",
